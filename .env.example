# Copy to mve/.env and fill in your values. .env is already in .gitignore and will not be committed.
#
# ========== Hackathon line: Nebius Token Factory (default backend, preferred) ==========
# Submission rules require the project to run on Nebius Token Factory / AI Cloud with NVIDIA open models.
# Create the key at studio.nebius.ai -> API keys (Create API key; shown once, save it).
# Available model IDs (verified 2026-10-14 against GET /v1/models, 25 models live):
#   nvidia/nemotron-3-super-120b-a12b        (default)
#   nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B    (cheaper/faster)
#   nvidia/Nemotron-3_5-Lightning
#   nvidia/Nemotron-3-Ultra-550b-a55b        (strongest)
# Always confirm against GET https://api.tokenfactory.nebius.com/v1/models —
# the catalogue changes (the nano ID is capitalized differently than you'd guess).
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# ========== Fallback backends below (only used when Nebius is NOT configured; ==========
# ========== with the three keys above set, these are never touched)            ==========
# N.E.K.O companion bridge (OpenAI-compatible) — local plugin scenario
MVE_QUIZ_BASE_URL=
MVE_QUIZ_API_KEY=
MVE_QUIZ_MODEL=glm-4-flash
# MVE's own Zhipu
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash

# ---- Switches (all optional; defaults documented in the README) ----
# Whether the main loop takes the code-based evidence path: 1 on / 0 off (default 0)
MVE_ACTION_CODE=1
# Knowledge graph layers: 1 on / 0 off
MVE_GRAPH=1
MVE_GRAPH_SEED=1
MVE_GRAPH_INSIGHT=1
MVE_GRAPH_SECTION=1
MVE_GRAPH_STAGE=1
MVE_GRAPH_RECIPE=1
# Debugging
MVE_DEBUG_PROMPT=0
MVE_ASSERT=1
