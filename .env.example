# 复制为 mve/.env 后填入自己的值。.env 已在 .gitignore 中，不会被提交。
#
# ========== 黑客松支线：Nebius Token Factory（默认后端，优先）==========
# 参赛规则要求提交必须跑在 Nebius Token Factory / AI Cloud 且用 NVIDIA 开源模型。
# 密钥在 studio.nebius.ai → API keys 创建（Create API key，只显示一次，保存好）。
# 可用模型 ID 以 GET https://api.tokenfactory.nebius.com/v1/models 为准；
# 备选：nvidia/nemotron-3-nano-30b-a3b（更便宜更快）、nvidia/nemotron-3-ultra-550b-a12b（最强）。
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# ========== 以下为回退后端（不填 Nebius 时才走；配了上面三项就不会用到）==========
# 猫娘桥（OpenAI 兼容）——本地 N.E.K.O 伴学插件场景
MVE_QUIZ_BASE_URL=
MVE_QUIZ_API_KEY=
MVE_QUIZ_MODEL=glm-4-flash
# MVE 自有智谱
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash

# ---- 开关（都可不填，默认见 README 的开关表）----
# 主循环是否走代码化取证路径：1 开 / 0 关（默认 0）
MVE_ACTION_CODE=1
# 图谱各层：1 开 / 0 关
MVE_GRAPH=1
MVE_GRAPH_SEED=1
MVE_GRAPH_INSIGHT=1
MVE_GRAPH_SECTION=1
MVE_GRAPH_STAGE=1
MVE_GRAPH_RECIPE=1
# 调试
MVE_DEBUG_PROMPT=0
MVE_ASSERT=1
